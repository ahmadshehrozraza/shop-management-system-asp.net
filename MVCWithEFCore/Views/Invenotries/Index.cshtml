@model IEnumerable<MVCWithEFCore.Models.Invenotry>

@{
    ViewData["Title"] = "Index";
}

<h1>Inventory</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProSupplier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProSubCat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProPricePerItem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProQuantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProOrderPrice)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProSupplier)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProSubCat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProPricePerItem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProOrderPrice)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
